{
  // Type-checks the simulation without DOM or Three.js types, so src/sim stays
  // runnable on the Node server in phase 5. Any DOM use in src/sim fails here.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/sim", "src/config", "tests"]
}
